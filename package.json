{
  "name": "octocloud",
  "version": "0.2.0",
  "description": "GitHub-backed authentication, sandboxed file and table storage, encrypted vault, hash-chained ledger, partitioned page shards, and WebRTC/federated multiplayer SDK for static web apps.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mk314k/octocloud.git"
  },
  "keywords": [
    "octocloud",
    "github-auth",
    "github-pages",
    "serverless-storage",
    "vector-search",
    "sqlite-vfs",
    "merkle-ledger",
    "peer-consensus",
    "encrypted-vault",
    "offline-sync",
    "pubsub",
    "webrtc-multiplayer",
    "oauth",
    "pat"
  ],
  "author": "mk314k",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "20.14.13",
    "tsx": "4.16.2",
    "typescript": "5.5.4"
  }
}
